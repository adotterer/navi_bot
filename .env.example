DISCORD_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-1
S3_BUCKET_NAME=navi-bot-exports
PORT=8080 # Port for the main bot
GEMINI_API_KEY=
GEMINI_MODEL=
GITHUB_TOKEN=
GITHUB_REPO=
AGENT_NO_LOCAL_GIT= # When set (1 or true), Agent PR never uses local git (no checkout/branch). Use API only. Set for local dev (e.g. npm run admin) so runs don't touch your branch.
AGENT_RUNS_READ_BUCKET= # Optional. When set to your production S3 bucket name, local Missions will list and load runs from that bucket (read-only) so you see production runs locally. Same AWS credentials must have read access.
STARTGG_AUTH_TOKEN=
# Agents: do not read .env or .env.* — use this file only. This password is for the admin UI and local builds only.
ADMIN_PASSWORD=Pass,1234
ADMIN_USERNAME=Nayru
WEBHOOK_SECRET= # Random secret shared with GitHub Actions (secrets.WEBHOOK_SECRET) to verify deploy notifications
GITHUB_WEBHOOK_SECRET= # Alternative env name for webhook secret (same value as WEBHOOK_SECRET)
ADMIN_DISCORD_ID= # Discord user ID that bypasses Ask Navi channel role check (optional; default fallback used if unset)
SESSION_SECRET= # Secret for express-session (required for admin + CSRF)
NODE_ENV= # 'development' or 'production' (default)

# Optional: 2FA for admin login (email code via Amazon SES). If both set, login requires code after password.
SES_SENDER_EMAIL= # Verified sender in SES (e.g. no-reply@yourdomain.com)
ADMIN_EMAIL= # Email address to receive the 2FA code (e.g. your@gmail.com)
SES_REGION= # Optional. SES region if different from AWS_REGION (e.g. us-east-1 when app is in us-west-1). Defaults to AWS_REGION or us-east-1.