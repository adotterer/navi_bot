DISCORD_TOKEN=
GUILD_ID= # Discord server ID for slash command registration (/coinflip, /ban) and REST role/channel lookups

# Zelda MU web app (server.js): Discord OAuth2 login + role-gated access.
# Client ID/Secret come from the same bot's application in the Discord Developer Portal (OAuth2 tab).
# Redirect URI must be registered there exactly, e.g. https://navi.adotterer.com/zelda/oauth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=
COACHING_PASS_ROLE_NAME=Coaching Pass # Discord role required to view /zelda/* guide pages
RECRUITER_PASSWORD= # Bypass password for demo purposes (e.g. job interviews) - grants full access without Discord OAuth
DEMO_ALERT_DISCORD_ID= # Your Discord user ID - gets @mentioned in #audit-logs in real time whenever a demo-access session logs in, views a guide, or regenerates one
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-1
S3_BUCKET_NAME=navi-bot-exports
PORT=8080 # Port for the main bot
GEMINI_API_KEY=
GEMINI_MODEL=
GITHUB_TOKEN=
GITHUB_REPO=
AGENT_NO_LOCAL_GIT= # When set (1 or true), Agent PR never uses local git (no checkout/branch). Use API only. Set for local dev (e.g. npm run admin) so runs don't touch your branch.
AGENT_RUNS_READ_BUCKET= # Optional. When set to your production S3 bucket name, local Missions will list and load runs from that bucket (read-only) so you see production runs locally. Same AWS credentials must have read access.
STARTGG_AUTH_TOKEN=
# Agents: do not read .env or .env.* — use this file only. This password is for the admin UI and local builds only.
ADMIN_PASSWORD=Pass,1234
ADMIN_USERNAME=Nayru
WEBHOOK_SECRET= # Random secret shared with GitHub Actions (secrets.WEBHOOK_SECRET) to verify deploy notifications
GITHUB_WEBHOOK_SECRET= # Alternative env name for webhook secret (same value as WEBHOOK_SECRET)
ADMIN_DISCORD_ID= # Discord user ID that bypasses Ask Navi channel role check (optional; default fallback used if unset)
SESSION_SECRET= # Secret for express-session (required for admin + CSRF)
NODE_ENV= # 'development' or 'production' (default)

# Optional: log file path for !logs. Default /var/log/web.stdout.log often requires root; set to a path the app user can read (e.g. app-owned log file).
LOG_PATH=

# Optional: 2FA for admin login (email code via Amazon SES). If both set, login requires code after password.
SES_SENDER_EMAIL= # Verified sender in SES (e.g. no-reply@yourdomain.com)
ADMIN_EMAIL= # Email address to receive the 2FA code (e.g. your@gmail.com)
SES_REGION= # Optional. SES region if different from AWS_REGION (e.g. us-east-1 when app is in us-west-1). Defaults to AWS_REGION or us-east-1.
SKIP_2FA_FOR_DEV= # Optional. Set to true (and NODE_ENV non-production) to skip 2FA for local/dev.

# Multi-admin: only the super admin (ADMIN_USERNAME/ADMIN_PASSWORD above) can invite others. Invitees get an email with a setup link; they set a password and then log in with their email + password. Requires DynamoDB and SES.
APP_BASE_URL= # Optional. Base URL for invite/setup links, stage list images, and self-hosted frame data hitbox images (e.g. https://yoursite.com). If unset, localhost is used (Discord embeds need a public URL for images).
AUTH_DYNAMODB_ID=
AUTH_DYNAMODB_SECRET=
AUTH_DYNAMODB_REGION=us-east-1
DYNAMODB_BAN_SESSIONS_TABLE= # Optional. Ban session storage (default: navi-ban-sessions). Create table with partition key pk (String). Same credentials as AUTH_DYNAMODB_*.
# S3 fallback: if AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are unset, S3 uses AUTH_DYNAMODB_ID/SECRET. Region uses AUTH_DYNAMODB_REGION when AWS_REGION is unset (same IAM often has S3 + DynamoDB).